@{
}
@model StudentPortal.web.Models.AddStudentViewModel

<form method="post">
<h1>Add Student</h1>

<div class="mt-3">
    <label class="form-label"> Name </label>
	<input class="form-control" type="text" asp-for="name" />
</div>

<div class="mt-3">
    <label class="form-label">Email </label>
	<input class="form-control" type="email" asp-for="email"/>
</div>

<div class="mt-3">
    <label class="form-label"> Phone </label>
    <input class="form-control" type="text" asp-for="phone" />
</div>

<div class="mt-3">
    <input type="checkbox" class="form-check-input"  id="subcribed" asp-for="subcribed"/>
	<label class="form-check-label" for="subcribed"> Subscribed to Newsletter </label>
</div>

<div class="mt-3">
	<button type="submit"class="btn btn-primary"> Submit </button>
</div>
</form>