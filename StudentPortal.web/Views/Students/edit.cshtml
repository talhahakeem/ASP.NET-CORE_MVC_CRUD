@{
}

@model StudentPortal.web.Models.Entities.Student

<form method="post">
    <h1>Edit Student</h1>
    @if(Model is null)
    {
        <p>No Student was found with this ID.</p>
    }
    @if (Model is not null)
    {

        <div class="mt-3">
            <label class="form-label"> ID </label>
            <input class="form-control" type="text" asp-for="id" readonly />
        </div>

        <div class="mt-3">
            <label class="form-label"> Name </label>
            <input class="form-control" type="text" asp-for="name" />
        </div>

        <div class="mt-3">
            <label class="form-label">Email </label>
            <input class="form-control" type="email" asp-for="email" />
        </div>

        <div class="mt-3">
            <label class="form-label"> Phone </label>
            <input class="form-control" type="text" asp-for="phone" />
        </div>

        <div class="mt-3">
            <input type="checkbox" class="form-check-input" id="subcribed" asp-for="subcribed" />
            <label class="form-check-label" for="subcribed"> Subscribed to Newsletter </label>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary"> Submit </button>
            <button type="submit" class="btn btn-danger ms-3" asp-action="Delete" asp-controller="Students"> Delete </button>
        </div>
    }
</form>
